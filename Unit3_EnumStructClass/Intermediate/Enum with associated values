enum PaymentMethod {
    case cash
    case card(number: String)
    case upi(id: String)
}

func showPayment(_ method: PaymentMethod) {
    switch method {
    case .cash:
        print("Payment by cash")
    case .card(let number):
        print("Card number:", number)
    case .upi(let id):
        print("UPI ID:", id)
    }
}

showPayment(.cash)
showPayment(.card(number: "1234"))
showPayment(.upi(id: "user@upi"))
