
func isPrime(_ number: Int) -> Bool {
    if number < 2 {
        return false
    }

    for i in 2..<number {
        if number % i == 0 {
            return false
        }
    }

    return true
}

let number = 7

if isPrime(number) {
    print("Prime")
} else {
    print("Not prime")
}

for i in 1...50 {
    if isPrime(i) {
        print(i)
    }
}
