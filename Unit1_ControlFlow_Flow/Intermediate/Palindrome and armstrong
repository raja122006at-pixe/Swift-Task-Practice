
import Foundation

let number = 153

// Palindrome check
var temp = number
var reverse = 0

while temp > 0 {
    reverse = reverse * 10 + temp % 10
    temp /= 10
}

if number == reverse {
    print("Palindrome")
} else {
    print("Not palindrome")
}

// Armstrong check
let digits = String(number).count
var value = number
var sum = 0

while value > 0 {
    let digit = value % 10
    sum += Int(pow(Double(digit), Double(digits)))
    value /= 10
}

if number == sum {
    print("Armstrong number")
} else {
    print("Not Armstrong")
}
