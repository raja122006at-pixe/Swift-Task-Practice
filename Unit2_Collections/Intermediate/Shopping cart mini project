
let prices: [String: Double] = [
    "Apple": 10.0,
    "Milk": 30.0,
    "Bread": 25.0,
    "Eggs": 8.0
]

let cart = ["Apple", "Milk", "Bread", "Eggs", "Apple"]
var total = 0.0

for item in cart {
    if let price = prices[item] {
        total += price
        print("\(item): Rs. \(price)")
    } else {
        print("\(item): Price not found")
    }
}

print("Total bill: Rs. \(total)")
